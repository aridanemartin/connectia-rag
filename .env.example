PORT=3000
LOG_LEVEL=info
AUTH_TOKEN=replace-with-a-secret-token-of-at-least-32-characters
AUTH_DISABLED=false
DATABASE_PATH=data/connectia.sqlite
TEMP_DIR=tmp
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=gemma3:12b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=connectia_documents
EMBEDDING_DIMENSIONS=1024
MAX_PDF_BYTES=26214400
MAX_ACTIVE_GENERATIONS=2
MAX_QUEUED_GENERATIONS=20
QUESTION_QUEUE_TIMEOUT_MS=30000
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.35
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_TTL_HOURS=24
ENABLE_INTERNAL_METRICS=false
