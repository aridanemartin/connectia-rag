meta {
  name: Legacy ask (filtered by documents)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ask
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "question": "¿Cuál es el plazo de matrícula?",
    "documentIds": ["{{documentId}}"]
  }
}

auth:bearer {
  token: {{authToken}}
}