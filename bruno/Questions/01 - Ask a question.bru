meta {
  name: Ask a question
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/questions
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "question": "¿Cuál es el plazo de matrícula?"
  }
}

auth:bearer {
  token: {{authToken}}
}