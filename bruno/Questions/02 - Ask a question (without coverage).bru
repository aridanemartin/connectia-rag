meta {
  name: Ask a question (without coverage)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/questions
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "question": "¿Quién fue el vencedor del mundial de fútbol de 1990?"
  }
}

auth:bearer {
  token: {{authToken}}
}