meta {
  name: Upload a PDF (new document)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/indexing/jobs
  body: multipartForm
  auth: bearer
}

headers {
  Accept: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:multipart-form {
  documentId: {{$randomUUID}}
  versionId: {{$randomUUID}}
  title: Documento de prueba Bruno 2026-2027
  academicYear: 2026-2027
  description: Documento de ejemplo creado desde la colección de Bruno.
  file: @file(../fixtures/pdfs/matricula-2026-2027.pdf)
}

auth:bearer {
  token: {{authToken}}
}