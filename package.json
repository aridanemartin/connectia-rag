{
  "name": "rag-mvp-implementation",
  "version": "1.0.0",
  "description": "Teacher-owned, Spanish-only RAG service for the Connectia course project. The service is designed for Node.js and TypeScript with LangChain, Ollama, Qdrant, SQLite, and Docker Compose on Ubuntu Server.",
  "main": "dist/src/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "wait:models": "node scripts/wait-for-models.ts",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.8",
    "@langchain/ollama": "^1.3.0",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "p-queue": "^9.3.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-dist": "^5.32.13",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
